{
  "name": "suwappu-perps-trader",
  "version": "2.0.0",
  "description": "Standalone read-only perpetual-futures risk monitor built on Suwappu",
  "type": "module",
  "bin": {
    "suwappu-perps": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts markets",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "mkdir -p dist && bun build src/cli.ts --compile --outfile dist/suwappu-perps"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": { "bun": ">=1.3.14" },
  "packageManager": "bun@1.3.14",
  "license": "MIT"
}
